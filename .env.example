# =============================================================================
# VisitSaudiArab WordPress environment configuration
# =============================================================================
# Copy this file to a safe location OUTSIDE the public document root, e.g.:
#   cPanel primary domain: /home/yourcpaneluser/private/visitsaudiarab.env
#   cPanel addon domain:   /home/yourcpaneluser/private/addondomain.env
#
# Then replace every placeholder with your real hosting values.
# NEVER commit the real .env file to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (create these in cPanel > MySQL Databases first)
# -----------------------------------------------------------------------------
DB_NAME=your_database_name
DB_USER=your_database_username
DB_PASSWORD=your_strong_database_password
DB_HOST=localhost
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_unicode_ci

# -----------------------------------------------------------------------------
# Site URLs (no trailing slash)
# -----------------------------------------------------------------------------
WP_HOME=https://visitsaudiarab.com
WP_SITEURL=https://visitsaudiarab.com

# -----------------------------------------------------------------------------
# Environment & debugging
# -----------------------------------------------------------------------------
# production | staging | development
WP_ENV=production

# On production: keep WP_DEBUG=false and WP_DEBUG_DISPLAY=false.
# Logs are written to wp-content/debug.log only when WP_DEBUG_LOG=true.
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false

# -----------------------------------------------------------------------------
# WordPress salts (generate at https://api.wordpress.org/secret-key/1.1/salt/)
# -----------------------------------------------------------------------------
AUTH_KEY=put_your_unique_phrase_here
SECURE_AUTH_KEY=put_your_unique_phrase_here
LOGGED_IN_KEY=put_your_unique_phrase_here
NONCE_KEY=put_your_unique_phrase_here
AUTH_SALT=put_your_unique_phrase_here
SECURE_AUTH_SALT=put_your_unique_phrase_here
LOGGED_IN_SALT=put_your_unique_phrase_here
NONCE_SALT=put_your_unique_phrase_here

# -----------------------------------------------------------------------------
# Optional: secure cookies over HTTPS
# -----------------------------------------------------------------------------
# COOKIE_DOMAIN=visitsaudiarab.com
